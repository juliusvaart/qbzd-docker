# Release to install (must match the checksums pinned in the Dockerfile).
QBZD_VERSION=2.0.2

# Host port for the qbzd control API.
QBZD_PORT=8182

# Owner of ./data — use your own ids (`id -u`, `id -g`) for a bind mount.
QBZD_UID=1000
QBZD_GID=1000

# Group that owns the ALSA device nodes: `stat -c %g /dev/snd/controlC0`.
# Not `/dev/snd` itself — that directory is often root-owned while the nodes
# inside it belong to `audio`, so reading the directory gives the wrong gid.
AUDIO_GID=29

TZ=UTC
